# ==============================================================================
# Contrail API Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8080
API_BASE_URL=https://airline.api.veyino.org

# Database & Storage
DB_PATH=./data/contrail.db

# Poller Engine Switch
POLLER_ENABLED=true

# Upstream Provider Configuration
# Options: "auto" (default: adsb.fi with OpenSky fallback), "adsb_fi", "opensky"
UPSTREAM_PROVIDER=auto

# adsb.fi Feeder Configuration
# Feeder stations get access to /v2/snapshot (30s refresh limit).
# We enforce 35s polling interval as safe buffer.
ADSB_FI_SNAPSHOT_URL=https://opendata.adsb.fi/api/v2/snapshot
ADSB_FI_POLL_INTERVAL_SEC=35

# OpenSky Network Configuration
# Registered users: 4,000 credits/day (4 credits per /states/all) -> 86.4s / call -> safe buffer: 90s
# Active Feeders: 8,000 credits/day -> 43.2s / call -> safe buffer: 50s
# Anonymous: IP-bucketed -> safe buffer: 60-90s
OPENSKY_URL=https://opensky-network.org/api/states/all
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_IS_FEEDER=false
OPENSKY_POLL_INTERVAL_SEC=90
# Optional Bounding Box for OpenSky: lamin,lomin,lamax,lomax
OPENSKY_BOUNDING_BOX=

# adsbdb Route & Airport Enrichment
# Rate limit: 512 req/min limit. We enforce 400 req/min token bucket.
# Missing/unknown callsigns cached for 24h to prevent redundant lookups.
ADS_B_DB_BASE_URL=https://api.adsbdb.com/v0/callsign/
ADS_B_DB_RATE_LIMIT_PER_MIN=400
CALLSIGN_CACHE_TTL_HOURS=24

# Data Retention Policy (Local SQLite Retention)
# Snapshots older than 90 days (3 months) are automatically purged.
RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_MIN=60

# Secrets (required; no defaults are compiled in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
CAP_SITE_KEY=
CAP_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_NOTIFY_EMAIL=
